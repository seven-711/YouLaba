rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny everything not explicitly matched
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Global Primitives & Role Helpers
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidClaimSlip(code) {
      return code is string && code.size() >= 5 && code.size() <= 32 && code.matches('^[A-Z0-9\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isBootstrapOwner() {
      return isVerified() && request.auth.token.email == 'claridadjulyfranz@gmail.com';
    }

    function userDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isOwner() {
      return isBootstrapOwner() || (
        isVerified() &&
        userDocExists() &&
        userDoc().role == 'owner' &&
        userDoc().active == true
      );
    }

    function isStaff() {
      return isOwner() || (
        isVerified() &&
        userDocExists() &&
        userDoc().role == 'staff' &&
        userDoc().active == true
      );
    }

    function isValidOrderStatus(s) {
      return s is string && s in ['Received', 'Washing', 'Drying', 'Folding/Ironing', 'Ready for Pickup', 'Claimed'];
    }

    function isValidPaymentStatus(s) {
      return s is string && s in ['Unpaid', 'Partial', 'Paid'];
    }

    function isValidPricingUnit(u) {
      return u is string && u in ['kg', 'load', 'piece'];
    }

    // =========================================================================
    // Entity Validation Blueprints (Anti-Update-Gap)
    // =========================================================================
    function isValidUserAccount(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'active', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'active', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.role is string && data.role in ['owner', 'staff', 'pending']
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidServiceRate(data) {
      return data.keys().hasAll(['name', 'description', 'pricingUnit', 'rate', 'minQuantity', 'turnaroundHours', 'category', 'active', 'updatedAt'])
        && data.keys().hasOnly(['name', 'description', 'pricingUnit', 'rate', 'minQuantity', 'turnaroundHours', 'category', 'active', 'updatedAt'])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 80
        && data.description is string && data.description.size() <= 260
        && isValidPricingUnit(data.pricingUnit)
        && data.rate is number && data.rate > 0 && data.rate <= 100000
        && data.minQuantity is number && data.minQuantity > 0 && data.minQuantity <= 1000
        && data.turnaroundHours is number && data.turnaroundHours >= 1 && data.turnaroundHours <= 720
        && data.category is string && data.category in ['Regular', 'Express', 'Specialty']
        && data.active is bool
        && data.updatedAt is timestamp;
    }

    function isValidShopSettings(data) {
      return data.keys().hasAll([
        'shopName', 'branchAddress', 'contactPhone', 'operatingHours',
        'defaultTurnaroundHours', 'unclaimedAlertHours', 'activePromoCode',
        'activePromoPercent', 'activePromoLabel', 'updatedAt'
      ])
        && data.keys().hasOnly([
          'shopName', 'branchAddress', 'contactPhone', 'operatingHours',
          'defaultTurnaroundHours', 'unclaimedAlertHours', 'activePromoCode',
          'activePromoPercent', 'activePromoLabel', 'updatedAt'
        ])
        && data.shopName is string && data.shopName.size() >= 2 && data.shopName.size() <= 80
        && data.branchAddress is string && data.branchAddress.size() >= 5 && data.branchAddress.size() <= 200
        && data.contactPhone is string && data.contactPhone.size() >= 7 && data.contactPhone.size() <= 40
        && data.operatingHours is string && data.operatingHours.size() >= 3 && data.operatingHours.size() <= 120
        && data.defaultTurnaroundHours is number && data.defaultTurnaroundHours >= 1 && data.defaultTurnaroundHours <= 720
        && data.unclaimedAlertHours is number && data.unclaimedAlertHours >= 1 && data.unclaimedAlertHours <= 720
        && data.activePromoCode is string && data.activePromoCode.size() <= 32
        && data.activePromoPercent is number && data.activePromoPercent >= 0 && data.activePromoPercent <= 100
        && data.activePromoLabel is string && data.activePromoLabel.size() <= 120
        && data.updatedAt is timestamp;
    }

    function isValidCustomer(data) {
      return data.keys().hasAll(['fullName', 'contactNumber', 'notes', 'totalOrders', 'createdByUid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['fullName', 'contactNumber', 'notes', 'totalOrders', 'createdByUid', 'createdAt', 'updatedAt'])
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100
        && data.contactNumber is string && data.contactNumber.size() >= 7 && data.contactNumber.size() <= 20 && data.contactNumber.matches('^[0-9+\\-\\s()]{7,20}$')
        && data.notes is string && data.notes.size() <= 250
        && data.totalOrders is number && data.totalOrders >= 0 && data.totalOrders <= 100000
        && isValidId(data.createdByUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLaundryOrder(data) {
      return data.keys().hasAll([
        'claimSlipNumber', 'customerId', 'customerName', 'customerPhone',
        'serviceId', 'serviceName', 'pricingUnit', 'unitRate', 'quantity',
        'bagCount', 'itemsSummary', 'specialInstructions', 'subtotal',
        'discountAmount', 'promoCode', 'totalPrice', 'status', 'paymentStatus',
        'amountPaid', 'paymentMethod', 'dropOffAt', 'estimatedClaimAt',
        'claimedAt', 'createdByUid', 'createdByName', 'updatedByUid',
        'updatedByName', 'createdAt', 'updatedAt'
      ])
        && data.keys().hasOnly([
          'claimSlipNumber', 'customerId', 'customerName', 'customerPhone',
          'serviceId', 'serviceName', 'pricingUnit', 'unitRate', 'quantity',
          'bagCount', 'itemsSummary', 'specialInstructions', 'subtotal',
          'discountAmount', 'promoCode', 'totalPrice', 'status', 'paymentStatus',
          'amountPaid', 'paymentMethod', 'dropOffAt', 'estimatedClaimAt',
          'claimedAt', 'createdByUid', 'createdByName', 'updatedByUid',
          'updatedByName', 'createdAt', 'updatedAt'
        ])
        && isValidClaimSlip(data.claimSlipNumber)
        && isValidId(data.customerId)
        && data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 100
        && data.customerPhone is string && data.customerPhone.size() >= 7 && data.customerPhone.size() <= 20
        && isValidId(data.serviceId)
        && data.serviceName is string && data.serviceName.size() >= 2 && data.serviceName.size() <= 80
        && isValidPricingUnit(data.pricingUnit)
        && data.unitRate is number && data.unitRate >= 0 && data.unitRate <= 100000
        && data.quantity is number && data.quantity > 0 && data.quantity <= 1000
        && data.bagCount is number && data.bagCount >= 1 && data.bagCount <= 100
        && data.itemsSummary is string && data.itemsSummary.size() <= 300
        && data.specialInstructions is string && data.specialInstructions.size() <= 300
        && data.subtotal is number && data.subtotal >= 0 && data.subtotal <= 1000000
        && data.discountAmount is number && data.discountAmount >= 0 && data.discountAmount <= 1000000
        && data.promoCode is string && data.promoCode.size() <= 32
        && data.totalPrice is number && data.totalPrice >= 0 && data.totalPrice <= 1000000
        && isValidOrderStatus(data.status)
        && isValidPaymentStatus(data.paymentStatus)
        && data.amountPaid is number && data.amountPaid >= 0 && data.amountPaid <= 1000000
        && data.paymentMethod is string && data.paymentMethod in ['None', 'Cash', 'GCash', 'Bank Transfer']
        && data.dropOffAt is string && data.dropOffAt.size() >= 10 && data.dropOffAt.size() <= 64
        && data.estimatedClaimAt is string && data.estimatedClaimAt.size() >= 10 && data.estimatedClaimAt.size() <= 64
        && data.claimedAt is string && data.claimedAt.size() <= 64
        && isValidId(data.createdByUid)
        && data.createdByName is string && data.createdByName.size() >= 1 && data.createdByName.size() <= 100
        && isValidId(data.updatedByUid)
        && data.updatedByName is string && data.updatedByName.size() >= 1 && data.updatedByName.size() <= 100
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidOrderTracking(data) {
      return data.keys().hasAll([
        'claimSlipNumber', 'customerLabel', 'serviceName', 'pricingUnit',
        'quantity', 'bagCount', 'totalPrice', 'paymentStatus', 'status',
        'dropOffAt', 'estimatedClaimAt', 'claimedAt', 'updatedAt'
      ])
        && data.keys().hasOnly([
          'claimSlipNumber', 'customerLabel', 'serviceName', 'pricingUnit',
          'quantity', 'bagCount', 'totalPrice', 'paymentStatus', 'status',
          'dropOffAt', 'estimatedClaimAt', 'claimedAt', 'updatedAt'
        ])
        && isValidClaimSlip(data.claimSlipNumber)
        && data.customerLabel is string && data.customerLabel.size() >= 1 && data.customerLabel.size() <= 40
        && data.serviceName is string && data.serviceName.size() >= 2 && data.serviceName.size() <= 80
        && isValidPricingUnit(data.pricingUnit)
        && data.quantity is number && data.quantity > 0 && data.quantity <= 1000
        && data.bagCount is number && data.bagCount >= 1 && data.bagCount <= 100
        && data.totalPrice is number && data.totalPrice >= 0 && data.totalPrice <= 1000000
        && isValidPaymentStatus(data.paymentStatus)
        && isValidOrderStatus(data.status)
        && data.dropOffAt is string && data.dropOffAt.size() >= 10 && data.dropOffAt.size() <= 64
        && data.estimatedClaimAt is string && data.estimatedClaimAt.size() >= 10 && data.estimatedClaimAt.size() <= 64
        && data.claimedAt is string && data.claimedAt.size() <= 64
        && data.updatedAt is timestamp;
    }

    function isValidPaymentRecord(data) {
      return data.keys().hasAll([
        'orderId', 'claimSlipNumber', 'amount', 'amountTendered',
        'changeGiven', 'method', 'notes', 'recordedByUid', 'recordedByName', 'createdAt'
      ])
        && data.keys().hasOnly([
          'orderId', 'claimSlipNumber', 'amount', 'amountTendered',
          'changeGiven', 'method', 'notes', 'recordedByUid', 'recordedByName', 'createdAt'
        ])
        && isValidId(data.orderId)
        && isValidClaimSlip(data.claimSlipNumber)
        && data.amount is number && data.amount > 0 && data.amount <= 1000000
        && data.amountTendered is number && data.amountTendered >= data.amount && data.amountTendered <= 1000000
        && data.changeGiven is number && data.changeGiven >= 0 && data.changeGiven <= 1000000
        && data.method is string && data.method in ['Cash', 'GCash', 'Bank Transfer']
        && data.notes is string && data.notes.size() <= 200
        && isValidId(data.recordedByUid)
        && data.recordedByName is string && data.recordedByName.size() >= 1 && data.recordedByName.size() <= 100
        && data.createdAt is timestamp;
    }

    function isValidStatusLog(data) {
      return data.keys().hasAll([
        'orderId', 'claimSlipNumber', 'action', 'fromStatus', 'toStatus',
        'note', 'actorUid', 'actorName', 'actorRole', 'createdAt'
      ])
        && data.keys().hasOnly([
          'orderId', 'claimSlipNumber', 'action', 'fromStatus', 'toStatus',
          'note', 'actorUid', 'actorName', 'actorRole', 'createdAt'
        ])
        && isValidId(data.orderId)
        && isValidClaimSlip(data.claimSlipNumber)
        && data.action is string && data.action in ['ORDER_CREATED', 'STATUS_UPDATED', 'PAYMENT_RECORDED', 'ORDER_CLAIMED', 'ORDER_CORRECTED']
        && data.fromStatus is string && data.fromStatus.size() <= 40
        && data.toStatus is string && data.toStatus.size() <= 40
        && data.note is string && data.note.size() <= 240
        && isValidId(data.actorUid)
        && data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 100
        && data.actorRole is string && data.actorRole in ['owner', 'staff']
        && data.createdAt is timestamp;
    }

    function isValidFeedback(data) {
      return data.keys().hasAll(['authorName', 'authorRole', 'claimSlipNumber', 'rating', 'category', 'message', 'status', 'createdAt'])
        && data.keys().hasOnly(['authorName', 'authorRole', 'claimSlipNumber', 'rating', 'category', 'message', 'status', 'createdAt'])
        && data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 80
        && data.authorRole is string && data.authorRole in ['customer', 'staff']
        && data.claimSlipNumber is string && data.claimSlipNumber.size() <= 32
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.category is string && data.category in ['Service Quality', 'Turnaround Time', 'Garment Care', 'System Issue', 'Suggestion']
        && data.message is string && data.message.size() >= 5 && data.message.size() <= 500
        && data.status is string && data.status in ['Open', 'Reviewed', 'Resolved']
        && data.createdAt is timestamp;
    }

    function isValidDailyReconciliation(data) {
      return data.keys().hasAll([
        'dateKey', 'systemCashTotal', 'actualCashCounted', 'cashVariance',
        'systemBagCount', 'actualBagCount', 'bagVariance', 'notes',
        'checkedByUid', 'checkedByName', 'createdAt'
      ])
        && data.keys().hasOnly([
          'dateKey', 'systemCashTotal', 'actualCashCounted', 'cashVariance',
          'systemBagCount', 'actualBagCount', 'bagVariance', 'notes',
          'checkedByUid', 'checkedByName', 'createdAt'
        ])
        && data.dateKey is string && data.dateKey.size() == 10 && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.systemCashTotal is number && data.systemCashTotal >= 0 && data.systemCashTotal <= 10000000
        && data.actualCashCounted is number && data.actualCashCounted >= 0 && data.actualCashCounted <= 10000000
        && data.cashVariance is number && data.cashVariance >= -10000000 && data.cashVariance <= 10000000
        && data.systemBagCount is number && data.systemBagCount >= 0 && data.systemBagCount <= 10000
        && data.actualBagCount is number && data.actualBagCount >= 0 && data.actualBagCount <= 10000
        && data.bagVariance is number && data.bagVariance >= -10000 && data.bagVariance <= 10000
        && data.notes is string && data.notes.size() <= 300
        && isValidId(data.checkedByUid)
        && data.checkedByName is string && data.checkedByName.size() >= 1 && data.checkedByName.size() <= 100
        && data.createdAt is timestamp;
    }

    // =========================================================================
    // 1. Users Collection (RBAC Accounts - PII Protected)
    // =========================================================================
    match /users/{userId} {
      allow get: if isVerified() && isValidId(userId) && (request.auth.uid == userId || isOwner());
      allow list: if isOwner();

      allow create: if isVerified()
        && isValidId(userId)
        && isValidUserAccount(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (request.auth.uid == userId && incoming().email == request.auth.token.email && (
            (isBootstrapOwner() && incoming().role == 'owner' && incoming().active == true) ||
            (incoming().role == 'pending' && incoming().active == false)
          )) ||
          isOwner()
        );

      allow update: if isVerified()
        && isValidId(userId)
        && isValidUserAccount(incoming())
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt'])) ||
          (isOwner() && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'role', 'active', 'updatedAt']))
        );

      allow delete: if isVerified() && isValidId(userId) && userId != request.auth.uid && isOwner();
    }

    // =========================================================================
    // 2. Services Collection (Public Menu & Rates, Owner Managed)
    // =========================================================================
    match /services/{serviceId} {
      allow get: if isValidId(serviceId);
      allow list: if true;

      allow create: if isVerified()
        && isValidId(serviceId)
        && isValidServiceRate(incoming())
        && incoming().updatedAt == request.time
        && isOwner();

      allow update: if isVerified()
        && isValidId(serviceId)
        && isValidServiceRate(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'description', 'pricingUnit', 'rate', 'minQuantity',
          'turnaroundHours', 'category', 'active', 'updatedAt'
        ])
        && isOwner();

      allow delete: if isVerified() && isValidId(serviceId) && isOwner();
    }

    // =========================================================================
    // 3. Shop Settings Collection (Public Policies & Promos, Owner Managed)
    // =========================================================================
    match /shopSettings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if false;

      allow create: if isVerified()
        && isValidId(settingId)
        && isValidShopSettings(incoming())
        && incoming().updatedAt == request.time
        && isOwner();

      allow update: if isVerified()
        && isValidId(settingId)
        && isValidShopSettings(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'shopName', 'branchAddress', 'contactPhone', 'operatingHours',
          'defaultTurnaroundHours', 'unclaimedAlertHours', 'activePromoCode',
          'activePromoPercent', 'activePromoLabel', 'updatedAt'
        ])
        && isOwner();

      allow delete: if false;
    }

    // =========================================================================
    // 4. Customers Collection (Protected PII - Verified Staff/Owner Only)
    // =========================================================================
    match /customers/{customerId} {
      allow get: if isVerified() && isValidId(customerId) && isStaff();
      allow list: if isStaff();

      allow create: if isVerified()
        && isValidId(customerId)
        && isValidCustomer(incoming())
        && incoming().createdByUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isStaff();

      allow update: if isVerified()
        && isValidId(customerId)
        && isValidCustomer(incoming())
        && incoming().createdByUid == existing().createdByUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'contactNumber', 'notes', 'totalOrders', 'updatedAt'])
        && isStaff();

      allow delete: if isVerified() && isValidId(customerId) && isOwner();
    }

    // =========================================================================
    // 5. Orders Collection (Core TPS Records - Verified Staff/Owner Only)
    // =========================================================================
    match /orders/{orderId} {
      allow get: if isVerified() && isValidId(orderId) && isStaff();
      allow list: if isStaff();

      allow create: if isVerified()
        && isValidId(orderId)
        && isValidLaundryOrder(incoming())
        && incoming().createdByUid == request.auth.uid
        && incoming().updatedByUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isStaff()
        && existsAfter(/databases/$(database)/documents/customers/$(incoming().customerId))
        && existsAfter(/databases/$(database)/documents/services/$(incoming().serviceId))
        && existsAfter(/databases/$(database)/documents/orderTracking/$(incoming().claimSlipNumber));

      allow update: if isVerified()
        && isValidId(orderId)
        && isValidLaundryOrder(incoming())
        && incoming().claimSlipNumber == existing().claimSlipNumber
        && incoming().customerId == existing().customerId
        && incoming().createdByUid == existing().createdByUid
        && incoming().createdByName == existing().createdByName
        && incoming().createdAt == existing().createdAt
        && incoming().updatedByUid == request.auth.uid
        && incoming().updatedAt == request.time
        && isStaff()
        && (
          // Owner override escape hatch (including corrections after Claimed)
          (isOwner() && incoming().diff(existing()).affectedKeys().hasOnly([
            'status', 'paymentStatus', 'amountPaid', 'paymentMethod',
            'claimedAt', 'estimatedClaimAt', 'specialInstructions',
            'itemsSummary', 'bagCount', 'discountAmount', 'promoCode',
            'totalPrice', 'updatedByUid', 'updatedByName', 'updatedAt'
          ])) ||
          // Staff Action 1: Stage transition (blocked once terminal 'Claimed')
          (existing().status != 'Claimed'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'claimedAt', 'updatedByUid', 'updatedByName', 'updatedAt'])) ||
          // Staff Action 2: Payment recording (blocked once terminal 'Claimed')
          (existing().status != 'Claimed'
            && incoming().diff(existing()).affectedKeys().hasOnly(['paymentStatus', 'amountPaid', 'paymentMethod', 'updatedByUid', 'updatedByName', 'updatedAt'])) ||
          // Staff Action 3: Combined Payment + Claim Release
          (existing().status != 'Claimed'
            && incoming().status == 'Claimed'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'claimedAt', 'paymentStatus', 'amountPaid', 'paymentMethod', 'updatedByUid', 'updatedByName', 'updatedAt']))
        );

      allow delete: if isVerified() && isValidId(orderId) && isOwner();
    }

    // =========================================================================
    // 6. OrderTracking Collection (PII-Isolated Public Lookup & Bounded Feed)
    // =========================================================================
    match /orderTracking/{claimSlipNumber} {
      // Public customer lookup by exact Claim Slip Number
      allow get: if isValidClaimSlip(claimSlipNumber);
      // Staff can list freely; public unauthenticated list is strictly bounded
      // to limit <= 10 for the landing page recent-orders feed (PII-stripped)
      allow list: if isStaff()
        || (request.query.limit != null && request.query.limit <= 10);

      allow create: if isVerified()
        && isValidClaimSlip(claimSlipNumber)
        && isValidOrderTracking(incoming())
        && incoming().claimSlipNumber == claimSlipNumber
        && incoming().updatedAt == request.time
        && isStaff();

      allow update: if isVerified()
        && isValidClaimSlip(claimSlipNumber)
        && isValidOrderTracking(incoming())
        && incoming().claimSlipNumber == existing().claimSlipNumber
        && incoming().dropOffAt == existing().dropOffAt
        && incoming().updatedAt == request.time
        && isStaff()
        && (
          isOwner() ||
          (existing().status != 'Claimed' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'paymentStatus', 'claimedAt', 'estimatedClaimAt', 'totalPrice', 'updatedAt']))
        );

      allow delete: if isVerified() && isValidClaimSlip(claimSlipNumber) && isOwner();
    }

    // =========================================================================
    // 7. Payments Collection (Immutable Financial Ledger)
    // =========================================================================
    match /payments/{paymentId} {
      allow get: if isVerified() && isValidId(paymentId) && isStaff();
      allow list: if isStaff();

      allow create: if isVerified()
        && isValidId(paymentId)
        && isValidPaymentRecord(incoming())
        && incoming().recordedByUid == request.auth.uid
        && incoming().createdAt == request.time
        && isStaff()
        && existsAfter(/databases/$(database)/documents/orders/$(incoming().orderId));

      allow update, delete: if false;
    }

    // =========================================================================
    // 8. StatusLogs Collection (Immutable Audit Trail)
    // =========================================================================
    match /statusLogs/{logId} {
      allow get: if isVerified() && isValidId(logId) && isStaff();
      allow list: if isStaff();

      allow create: if isVerified()
        && isValidId(logId)
        && isValidStatusLog(incoming())
        && incoming().actorUid == request.auth.uid
        && incoming().createdAt == request.time
        && isStaff()
        && existsAfter(/databases/$(database)/documents/orders/$(incoming().orderId));

      allow update, delete: if false;
    }

    // =========================================================================
    // 9. Feedback Collection (Public Submission, Staff/Owner Review)
    // =========================================================================
    match /feedback/{feedbackId} {
      allow get: if isVerified() && isValidId(feedbackId) && isStaff();
      allow list: if isStaff();

      allow create: if isValidId(feedbackId)
        && isValidFeedback(incoming())
        && incoming().status == 'Open'
        && incoming().createdAt == request.time
        && (incoming().authorRole == 'customer' || isStaff());

      allow update: if isVerified()
        && isValidId(feedbackId)
        && isValidFeedback(incoming())
        && incoming().authorName == existing().authorName
        && incoming().authorRole == existing().authorRole
        && incoming().message == existing().message
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['status'])
        && isStaff();

      allow delete: if isVerified() && isValidId(feedbackId) && isOwner();
    }

    // =========================================================================
    // 10. DailyReconciliations Collection (Owner Cash & Bag Verification)
    // =========================================================================
    match /dailyReconciliations/{reconciliationId} {
      allow get: if isVerified() && isValidId(reconciliationId) && isOwner();
      allow list: if isOwner();

      allow create: if isVerified()
        && isValidId(reconciliationId)
        && isValidDailyReconciliation(incoming())
        && incoming().checkedByUid == request.auth.uid
        && incoming().createdAt == request.time
        && isOwner();

      allow update: if isVerified()
        && isValidId(reconciliationId)
        && isValidDailyReconciliation(incoming())
        && incoming().dateKey == existing().dateKey
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'systemCashTotal', 'actualCashCounted', 'cashVariance',
          'systemBagCount', 'actualBagCount', 'bagVariance', 'notes',
          'checkedByUid', 'checkedByName'
        ])
        && isOwner();

      allow delete: if isVerified() && isValidId(reconciliationId) && isOwner();
    }
  }
}
