{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Shop Owner or Laundry Attendant staff account for role-based access control.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 160
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "role": {
          "type": "string",
          "enum": ["owner", "staff", "pending"]
        },
        "active": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "displayName", "role", "active", "createdAt", "updatedAt"]
    },
    "ServiceRate": {
      "title": "ServiceRate",
      "description": "Laundry service type, rate per kg or load, turnaround hours, and active status.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "maxLength": 260
        },
        "pricingUnit": {
          "type": "string",
          "enum": ["kg", "load", "piece"]
        },
        "rate": {
          "type": "number"
        },
        "minQuantity": {
          "type": "number"
        },
        "turnaroundHours": {
          "type": "number"
        },
        "category": {
          "type": "string",
          "enum": ["Regular", "Express", "Specialty"]
        },
        "active": {
          "type": "boolean"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["name", "description", "pricingUnit", "rate", "minQuantity", "turnaroundHours", "category", "active", "updatedAt"]
    },
    "ShopSettings": {
      "title": "ShopSettings",
      "description": "Shop operating policies, standard turnaround settings, promotions, and contact details for YouLaba Nazareth, Cagayan de Oro City.",
      "type": "object",
      "properties": {
        "shopName": {
          "type": "string",
          "maxLength": 80
        },
        "branchAddress": {
          "type": "string",
          "maxLength": 200
        },
        "contactPhone": {
          "type": "string",
          "maxLength": 40
        },
        "operatingHours": {
          "type": "string",
          "maxLength": 120
        },
        "defaultTurnaroundHours": {
          "type": "number"
        },
        "unclaimedAlertHours": {
          "type": "number"
        },
        "activePromoCode": {
          "type": "string",
          "maxLength": 32
        },
        "activePromoPercent": {
          "type": "number"
        },
        "activePromoLabel": {
          "type": "string",
          "maxLength": 120
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["shopName", "branchAddress", "contactPhone", "operatingHours", "defaultTurnaroundHours", "unclaimedAlertHours", "activePromoCode", "activePromoPercent", "activePromoLabel", "updatedAt"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Registered laundry customer profile containing protected PII (Data Privacy Act of 2012).",
      "type": "object",
      "properties": {
        "fullName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "contactNumber": {
          "type": "string",
          "minLength": 7,
          "maxLength": 20,
          "pattern": "^[0-9+\\-\\s()]{7,20}$"
        },
        "notes": {
          "type": "string",
          "maxLength": 250
        },
        "totalOrders": {
          "type": "number"
        },
        "createdByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["fullName", "contactNumber", "notes", "totalOrders", "createdByUid", "createdAt", "updatedAt"]
    },
    "LaundryOrder": {
      "title": "LaundryOrder",
      "description": "Full TPS transaction record for a single laundry drop-off through claiming.",
      "type": "object",
      "properties": {
        "claimSlipNumber": {
          "type": "string",
          "minLength": 5,
          "maxLength": 32,
          "pattern": "^[A-Z0-9\\-]+$"
        },
        "customerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "customerPhone": {
          "type": "string",
          "minLength": 7,
          "maxLength": 20
        },
        "serviceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "serviceName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "pricingUnit": {
          "type": "string",
          "enum": ["kg", "load", "piece"]
        },
        "unitRate": {
          "type": "number"
        },
        "quantity": {
          "type": "number"
        },
        "bagCount": {
          "type": "number"
        },
        "itemsSummary": {
          "type": "string",
          "maxLength": 300
        },
        "specialInstructions": {
          "type": "string",
          "maxLength": 300
        },
        "subtotal": {
          "type": "number"
        },
        "discountAmount": {
          "type": "number"
        },
        "promoCode": {
          "type": "string",
          "maxLength": 32
        },
        "totalPrice": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["Received", "Washing", "Drying", "Folding/Ironing", "Ready for Pickup", "Claimed"]
        },
        "paymentStatus": {
          "type": "string",
          "enum": ["Unpaid", "Partial", "Paid"]
        },
        "amountPaid": {
          "type": "number"
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["None", "Cash", "GCash", "Bank Transfer"]
        },
        "dropOffAt": {
          "type": "string",
          "format": "date-time"
        },
        "estimatedClaimAt": {
          "type": "string",
          "format": "date-time"
        },
        "claimedAt": {
          "type": "string",
          "maxLength": 64
        },
        "createdByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdByName": {
          "type": "string",
          "maxLength": 100
        },
        "updatedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedByName": {
          "type": "string",
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "claimSlipNumber", "customerId", "customerName", "customerPhone",
        "serviceId", "serviceName", "pricingUnit", "unitRate", "quantity",
        "bagCount", "itemsSummary", "specialInstructions", "subtotal",
        "discountAmount", "promoCode", "totalPrice", "status", "paymentStatus",
        "amountPaid", "paymentMethod", "dropOffAt", "estimatedClaimAt",
        "claimedAt", "createdByUid", "createdByName", "updatedByUid",
        "updatedByName", "createdAt", "updatedAt"
      ]
    },
    "OrderTrackingPublic": {
      "title": "OrderTrackingPublic",
      "description": "PII-isolated public status summary keyed by Claim Slip Number for customer self-service lookup.",
      "type": "object",
      "properties": {
        "claimSlipNumber": {
          "type": "string",
          "minLength": 5,
          "maxLength": 32,
          "pattern": "^[A-Z0-9\\-]+$"
        },
        "customerLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "serviceName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "pricingUnit": {
          "type": "string",
          "enum": ["kg", "load", "piece"]
        },
        "quantity": {
          "type": "number"
        },
        "bagCount": {
          "type": "number"
        },
        "totalPrice": {
          "type": "number"
        },
        "paymentStatus": {
          "type": "string",
          "enum": ["Unpaid", "Partial", "Paid"]
        },
        "status": {
          "type": "string",
          "enum": ["Received", "Washing", "Drying", "Folding/Ironing", "Ready for Pickup", "Claimed"]
        },
        "dropOffAt": {
          "type": "string",
          "maxLength": 64
        },
        "estimatedClaimAt": {
          "type": "string",
          "maxLength": 64
        },
        "claimedAt": {
          "type": "string",
          "maxLength": 64
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "claimSlipNumber", "customerLabel", "serviceName", "pricingUnit",
        "quantity", "bagCount", "totalPrice", "paymentStatus", "status",
        "dropOffAt", "estimatedClaimAt", "claimedAt", "updatedAt"
      ]
    },
    "PaymentRecord": {
      "title": "PaymentRecord",
      "description": "Immutable payment transaction record tied to a laundry order.",
      "type": "object",
      "properties": {
        "orderId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "claimSlipNumber": {
          "type": "string",
          "minLength": 5,
          "maxLength": 32,
          "pattern": "^[A-Z0-9\\-]+$"
        },
        "amount": {
          "type": "number"
        },
        "amountTendered": {
          "type": "number"
        },
        "changeGiven": {
          "type": "number"
        },
        "method": {
          "type": "string",
          "enum": ["Cash", "GCash", "Bank Transfer"]
        },
        "notes": {
          "type": "string",
          "maxLength": 200
        },
        "recordedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "recordedByName": {
          "type": "string",
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["orderId", "claimSlipNumber", "amount", "amountTendered", "changeGiven", "method", "notes", "recordedByUid", "recordedByName", "createdAt"]
    },
    "StatusLog": {
      "title": "StatusLog",
      "description": "Immutable audit trail recording order creation, stage transitions, payments, and releases.",
      "type": "object",
      "properties": {
        "orderId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "claimSlipNumber": {
          "type": "string",
          "minLength": 5,
          "maxLength": 32,
          "pattern": "^[A-Z0-9\\-]+$"
        },
        "action": {
          "type": "string",
          "enum": ["ORDER_CREATED", "STATUS_UPDATED", "PAYMENT_RECORDED", "ORDER_CLAIMED", "ORDER_CORRECTED"]
        },
        "fromStatus": {
          "type": "string",
          "maxLength": 40
        },
        "toStatus": {
          "type": "string",
          "maxLength": 40
        },
        "note": {
          "type": "string",
          "maxLength": 240
        },
        "actorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "actorName": {
          "type": "string",
          "maxLength": 100
        },
        "actorRole": {
          "type": "string",
          "enum": ["owner", "staff"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["orderId", "claimSlipNumber", "action", "fromStatus", "toStatus", "note", "actorUid", "actorName", "actorRole", "createdAt"]
    },
    "FeedbackEntry": {
      "title": "FeedbackEntry",
      "description": "Customer or staff feedback submission for service quality and issue reporting.",
      "type": "object",
      "properties": {
        "authorName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "authorRole": {
          "type": "string",
          "enum": ["customer", "staff"]
        },
        "claimSlipNumber": {
          "type": "string",
          "maxLength": 32
        },
        "rating": {
          "type": "number"
        },
        "category": {
          "type": "string",
          "enum": ["Service Quality", "Turnaround Time", "Garment Care", "System Issue", "Suggestion"]
        },
        "message": {
          "type": "string",
          "minLength": 5,
          "maxLength": 500
        },
        "status": {
          "type": "string",
          "enum": ["Open", "Reviewed", "Resolved"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["authorName", "authorRole", "claimSlipNumber", "rating", "category", "message", "status", "createdAt"]
    },
    "DailyReconciliation": {
      "title": "DailyReconciliation",
      "description": "Owner end-of-day verification comparing system totals against physical cash and laundry bags received.",
      "type": "object",
      "properties": {
        "dateKey": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "systemCashTotal": {
          "type": "number"
        },
        "actualCashCounted": {
          "type": "number"
        },
        "cashVariance": {
          "type": "number"
        },
        "systemBagCount": {
          "type": "number"
        },
        "actualBagCount": {
          "type": "number"
        },
        "bagVariance": {
          "type": "number"
        },
        "notes": {
          "type": "string",
          "maxLength": 300
        },
        "checkedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "checkedByName": {
          "type": "string",
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "dateKey", "systemCashTotal", "actualCashCounted", "cashVariance",
        "systemBagCount", "actualBagCount", "bagVariance", "notes",
        "checkedByUid", "checkedByName", "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "Staff and Owner accounts with RBAC roles."
    },
    "/services/{serviceId}": {
      "schema": { "$ref": "#/entities/ServiceRate" },
      "description": "Publicly readable laundry service menu and rates managed by the Shop Owner."
    },
    "/shopSettings/{settingId}": {
      "schema": { "$ref": "#/entities/ShopSettings" },
      "description": "Shop branch info, turnaround policies, and active promotions."
    },
    "/customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "Protected customer directory with contact PII accessible only to verified Owner/Staff."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/LaundryOrder" },
      "description": "Full TPS laundry orders accessible only to verified Owner/Staff."
    },
    "/orderTracking/{claimSlipNumber}": {
      "schema": { "$ref": "#/entities/OrderTrackingPublic" },
      "description": "PII-isolated public status lookup documents keyed by exact Claim Slip Number (get-only for public, no list)."
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/PaymentRecord" },
      "description": "Immutable payment ledger entries tied to orders."
    },
    "/statusLogs/{logId}": {
      "schema": { "$ref": "#/entities/StatusLog" },
      "description": "Immutable audit trail of all order creations, stage changes, and claims."
    },
    "/feedback/{feedbackId}": {
      "schema": { "$ref": "#/entities/FeedbackEntry" },
      "description": "Customer and staff feedback submissions; public create allowed, staff/owner read & resolve."
    },
    "/dailyReconciliations/{reconciliationId}": {
      "schema": { "$ref": "#/entities/DailyReconciliation" },
      "description": "Owner-only daily cash and bag count verification records."
    }
  }
}
